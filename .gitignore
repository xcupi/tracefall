/tracefall
/bin/
*.db
*.db-journal
*.db-wal
*.db-shm
/data/

# Server integration credentials, including custom data directories.
**/.integrations/

# Forensic evidence images must never be committed. /data/ already covers
# everything Tracefall stores itself, but an analyst working in the tree
# can easily drop an image beside the source -- and a 700 MB AD1 in the
# history cannot be removed without rewriting it.
#
# testdata/ is deliberately exempt: it holds small SYNTHETIC fixtures
# (testdata/ad1_samples/DiskDrigger.ad1 is 3.6 KB and generated by
# internal/ad1/ad1gen), which are intentionally tracked.
*.ad1
*.ad[0-9]
*.e01
*.E01
*.dd
*.raw
!testdata/**

# Profiling and trace output. The ingestion benchmarks write these when
# TRACEFALL_PROF_DIR points into the tree.
*.pprof
*.prof
*.trace

# Local agent state and plans (may hold local paths); never commit.
/.hermes/

# Editor/agent run configuration; local only.
/.claude/
